# Docker Configuration
CONTAINER_NAME=paperless-ai
EXTERNAL_PORT=3000
PAPERLESS_AI_PORT=3000
PUID=1000
PGID=1000

# Data Storage Path
# Use absolute path for bind mount (e.g., /volume1/docker/paperlessngxai or C:\Users\YourName\Docker\paperless-ai\data)
# Or use relative path (e.g., ./data)
DATA_PATH=./data

# RAG Service Configuration
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_ENABLED=true
